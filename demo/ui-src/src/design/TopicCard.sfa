<template>
    <Column :modifier="cardModifier">
        <Box content-alignment="Center" :modifier="M.size(56.dp, 56.dp).background(Color(theme.fill), rounded(16.dp))">
            <Icon :painter="iconPainter" :tint="Color(theme.label)" :modifier="M.size(26.dp, 26.dp)" />
        </Box>
        <Spacer :modifier="M.height(36.dp)" />
        <Text :text="title" :style="{ fontSize: typeScale.cardTitle.sp, color: Color(theme.label) }" />
        <Spacer :modifier="M.height(6.dp)" />
        <Text :text="description" :max-lines="2" overflow="ellipsis" :style="{ fontSize: typeScale.footnote.sp, color: Color(theme.secondaryLabel) }" />
    </Column>
</template>

<script>
import { computed, createInteractionState } from '@arrange/framework'
import { Color, M, painter, rounded } from '@arrange/framework/ui'
import { animatedNumberAsRef, spring, tween } from '@arrange/framework/animation'
import { typeScale, useGalleryTheme } from './theme'

const { title, description, icon, onClick } = defineProps<{ title: string; description: string; icon: string; onClick: () => void }>()
const theme = useGalleryTheme()
const iconPainter = computed(() => painter(icon))
const interaction = createInteractionState()
// 悬停时浮起一层柔和阴影；按下时整卡轻微收缩，松手回弹
const scale = animatedNumberAsRef(() => interaction.pressed ? 0.97 : 1, { animationSpec: spring({ stiffness: 600, dampingRatio: 0.7 }) })
const lift = animatedNumberAsRef(() => interaction.hovered && !interaction.pressed ? 1 : 0, { animationSpec: tween({ durationMillis: 160 }) })
const cardModifier = computed(() => {
    const shape = rounded(36.dp)
    // 悬停只改阴影数值，链条形状不变时走单实例参数更新
    const shadow = Math.round(lift.value * 0x14) * 0x1000000
    return M.fillMaxSize()
        .graphicsLayer({ scaleX: scale.value, scaleY: scale.value })
        .dropShadow({ shape, radius: (8 + 12 * lift.value).dp, offset: { y: (2 + 4 * lift.value).dp }, color: Color(shadow) })
        .background(Color(theme.value.card), shape)
        .clickable({ onClick, interactionState: interaction })
        .pointerIcon('hand')
        .semantics({ role: 'button', label: title })
        .padding(20.dp)
})
</script>
