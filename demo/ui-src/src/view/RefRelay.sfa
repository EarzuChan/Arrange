<template>
    <Column :modifier="M.padding(8.dp).background(Color(0xff202633))" :vertical-arrangement="Arrangement.spacedBy(4.dp)">
        <Text :text="`原样 Ref：${name}`" :style="{ fontSize: 11.sp, color: Color(0xff61d6bb) }" />
        <Text :text="`子层读取 state：` + state.value" :style="{ fontSize: 11.sp, color: Color(0xffedf4fa) }" />
        <Text :text="`点击切换 Ref（当前 ${name}）`" :modifier="M.padding(5.dp).background(Color(0xff374866)).clickable(onToggle)" :style="{ fontSize: 10.sp, color: Color(0xffffffff) }" />
    </Column>
</template>

<script>
import type { Ref } from '@arrange/framework'
import { Arrangement, M, Color } from '@arrange/framework/ui'
import { Column, Text } from '@arrange/framework/foundation'

const { state, name, onToggle } = defineProps<{ state: Ref<number>; name: string; onToggle: () => void }>()
</script>