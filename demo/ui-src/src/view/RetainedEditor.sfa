<template>
    <Column :vertical-arrangement="Arrangement.spacedBy(dp(8))">
        <Text text="保留页面 · 输入与状态" :style="{fontSize: sp(15), color: Color(0xff61d6bb)}" />

        <Input :value="note" :onValueChange="value => note = value" :text-style="{color: Color(0xffedf4fa)}" :modifier="M.width(dp(300)).height(dp(32)).background(Color(0xff263443)).padding(dp(6))" />

        <Text :text="`笔记：${note}`" :style="{fontSize: sp(12), color: Color(0xffc7d5e1)}" />
    </Column>
</template>

<script>
import { ref } from '@arrange/framework'
import { M, Arrangement, dp, sp, Color } from '@arrange/framework/ui'

const note = ref('切页后仍保留这段笔记')
</script>