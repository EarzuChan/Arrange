<template>
    <Column :vertical-arrangement="Arrangement.spacedBy(6.dp)" :modifier="M.width(330.dp).padding(8.dp).background(Color(0xff202633))">
        <Text text="动画の画廊" :style="{ fontSize: 17.sp, color: Color(0xffeeeeee) }"/>

        <Row :horizontal-arrangement="Arrangement.spacedBy(6.dp)">
            <Text text="耍起嘛" :style="{ color: Color(0xffffffff) }" :modifier="M.padding(6.dp).background(Color(0xff374866)).clickable(() => run('all'))"/>

            <Text text="统计" :style="{ color: Color(0xffffffff) }" :modifier="M.padding(6.dp).background(Color(0xff374866)).clickable(() => run('stats'))"/>
        </Row>

        <Row :horizontal-arrangement="Arrangement.spacedBy(8.dp)">
            <Box :modifier="M.width(72.dp).height(24.dp).background(color)"/>

            <Box :modifier="M.size(dimensions.width.dp, dimensions.height.dp).offset({ x: position.x.dp, y: position.y.dp }).background(Color(0xffc18ff0))"/>
        </Row>

        <ValueSurface :tone="groupColor" :offset="groupOffset">
            <Box :modifier="M.size(72.dp, 12.dp)"/>
        </ValueSurface>

        <Column :modifier="M.animateContentSize(spec).background(Color(0xff303b4d)).padding(6.dp)">
            <Text :text="label" :style="{ color: Color(0xffdddddd), fontSize: 12.sp }"/>

            <Text a-if="expanded" text="相邻内容跟随动画高度放置" :style="{ color: Color(0xffeeeeee), fontSize: 12.sp }" :modifier="M.height(28.dp)"/>
        </Column>

        <AnimatedVisibility :visible="visible" :animation-spec="spec" :enter-from="{ alpha: 0, translationX: -16.px }" :exit-to="{ alpha: 0, translationX: 16.px }">
            <Row :horizontal-arrangement="Arrangement.spacedBy(6.dp)">
                <Text text="可视啊一个内容" :style="{ color: Color(0xffeeeeee) }"/>

                <Input value="编辑我，如果我彻底离场会被重置" :modifier="M.size(130.dp, 24.dp).background(Color(0xff151922))"/> // FIXME：刚开始离场就重置文本了。或涉及两个问题：刚开始离场为什么会换掉实例，未彻底离场能否复用实例。且得对齐 Compose 实现
            </Row>
        </AnimatedVisibility>

        <Crossfade :is="Text" :props="{ text: `页面啊一个 ${page}`, style: { color: Color(0xffeeeeee) }, modifier: M.padding(5.dp).background(page === 'A' ? Color(0xff315a72) : Color(0xff6c395e)) }" :targetState="page" :animationSpec="spec"/>

        <Text :text="status" :style="{ fontSize: 10.sp, color: Color(0xffaabbcc) }"/>
    </Column>
</template>

<script>
import { Text } from '@arrange/framework/foundation'
import { AnimatedVisibility, Crossfade, tween, spring, linearEasing, animatedColorAsRef, animatedOffsetAsRef, animatedSizeAsRef, createTransition, animationStats } from '@arrange/framework/animation'
import { Arrangement, M, modifierStats, modifierAllocationStats, Color } from '@arrange/framework/ui'
import { ref, computed, watch } from '@arrange/framework'
import { getArrangeExecutionStats } from '@arrange/framework/internal'
import ValueSurface from './ValueSurface.sfa'

const props = defineProps({ command: { type: String, default: '' } })

const expanded = ref(false)
const visible = ref(true)
const page = ref('A')
const colorTarget = ref(Color(0xff41b883))
const positionTarget = ref({ x: 0.dp, y: 0.dp })
const sizeTarget = ref({ width: 72.dp, height: 24.dp })
const spec = tween({ durationMillis: 320, easing: linearEasing })
const color = animatedColorAsRef(colorTarget, { animationSpec: spec })
const position = animatedOffsetAsRef(positionTarget, { animationSpec: spring({ stiffness: 220, dampingRatio: 0.8 }) })
const dimensions = animatedSizeAsRef(sizeTarget, { animationSpec: spec })
const transition = createTransition(expanded, { animationSpec: spec })
const groupColor = transition.animatedColor('group-color', state => state ? Color(0xffe9b949) : Color(0xff5798ef))
const groupOffset = transition.animatedDp('group-offset', state => state ? 24.dp : 0.dp)
const label = computed(() => expanded.value ? '展开的啊一个内容。野兽先辈恶臭114514' : '紧绷の内容')
const status = ref('动画、反向、隐藏、恢复和切页')
let baseline: ReturnType<typeof getArrangeExecutionStats> | undefined

function run(command: string) {
    switch (command) {
        case 'baseline':
            baseline = getArrangeExecutionStats()
            break

        case 'color':
            colorTarget.value = colorTarget.value === Color(0xff41b883) ? Color(0xffe66b8b) : Color(0xff41b883)
            break

        case 'move':
            positionTarget.value = { x: positionTarget.value.x ? 0 : 28, y: 0.dp }
            break

        case 'size':
            sizeTarget.value = { width: sizeTarget.value.width === 72 ? 130 : 72, height: 24.dp }
            break

        case 'expand':
            expanded.value = !expanded.value
            break

        case 'visibility':
            visible.value = !visible.value
            break

        case 'page':
            page.value = page.value === 'A' ? 'B' : 'A'
            break

        case 'all':
            run('color')
            run('move')
            run('size')
            run('expand')
            run('visibility')
            run('page')
            break

        case 'validate-color':
            if (getArrangeExecutionStats().structureRuns !== baseline?.structureRuns) throw new Error('颜色动画错误地重跑了结构')
            break

        case 'validate-settled':
            if (animationStats.activeAnimations !== 0) throw new Error('画廊动画结束后仍保留帧需求')
            break

        case 'stats': {
            const stats = getArrangeExecutionStats()
            status.value = `结构 ${stats.structureRuns} / 值 ${stats.valueEvaluations} / 参数 ${modifierStats.parameterEvaluations} / 链 ${modifierAllocationStats.chains}`
            break
        }
    }
}

// 命令Prop也驱动这个啊一个，有这个威能
watch(() => props.command, command => run(command), { flush: 'sync' })
</script>