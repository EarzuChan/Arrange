<template>
    <Column :vertical-arrangement="Arrangement.spacedBy(8.dp)">
        <Canvas :modifier="M.fillMaxWidth().height(12.dp)" :on-draw="drawLevel"/>
        <Canvas :modifier="M.fillMaxWidth().height(72.dp)" :on-draw="drawSamples"/>
        <Canvas :modifier="M.fillMaxWidth().height(72.dp)" :on-draw="drawBins"/>
    </Column>
</template>

<script>
// B 档：原生数据源加 JS 绘制，读取不经响应式，Canvas 按数据源版本重录
import { meterSource, waveformSource, spectrumSource } from '@arrange/framework/interop'
import { Arrangement, M, type DrawScope } from '@arrange/framework/ui'
import { Canvas } from '@arrange/framework/foundation'
import { drawMeter, drawWaveform, drawSpectrum } from './tierDrawing.ts'

const meter = meterSource('output')
const waveform = waveformSource('output', { size: 256 })
const spectrum = spectrumSource('output')

const drawLevel = (scope: DrawScope) => drawMeter(scope, meter.read()[0] ?? 0)
const drawSamples = (scope: DrawScope) => drawWaveform(scope, waveform.read())
const drawBins = (scope: DrawScope) => drawSpectrum(scope, spectrum.read())
</script>
