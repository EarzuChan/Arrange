<template>
    <Column :modifier="M.if(horizontal, M.width(138.dp), M.fillMaxWidth()).height(item.height.dp).padding(7.dp).background(selected ? Color(0xff315c63) : item.id % 12 === 0 ? Color(0xff3d3656) : Color(0xff223647)).clickable(() => onSelect(item.id))" :vertical-arrangement="Arrangement.spacedBy(4.dp)">
        <Text :text="`${item.id % 12 === 0 ? '分组' : '条目'} ${item.id} · ${item.name}`" :single-line="true" overflow="ellipsis" :style="{ fontSize: 11.sp, color: Color(0xffe6f1f8) }" />
        <Input :value="item.note" :onValueChange="value => item.note = value" :single-line="true" placeholder="写点什么" :text-style="{ fontSize: 10.sp, color: Color(0xffbfdae5) }" :modifier="M.fillMaxWidth().height(24.dp).background(Color(0xff172733)).padding(3.dp)" />
    </Column>
</template>

<script>
import { M, Arrangement, Color } from '@arrange/framework/ui'
defineProps<{ item: { id: number; name: string; note: string; height: number }; selected: boolean; horizontal: boolean; onSelect: (id: number) => void }>()
</script>
