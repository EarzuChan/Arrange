<template>
    <ValueSurface :tone="tone" :offset="offset">
        <Text :text="label" :style="{fontSize: 13.sp, color: Color(0xFFE8EAED)}" :modifier="M.size(160.dp, 28.dp).clickable(onTap)"/>
    </ValueSurface>
</template>

<script>
import type { Dp, ColorValue } from '@arrange/framework/ui'
import { computed } from '@arrange/framework'
import { M, Color } from '@arrange/framework/ui'
import ValueSurface from './ValueSurface.sfa'

const props = defineProps<{ clicks: number; color: ColorValue; offset: Dp; onTap: () => void }>()
const label = computed(() => `撅了啊 ${props.clicks} 次`)
const tone = computed(() => props.color)

</script>
