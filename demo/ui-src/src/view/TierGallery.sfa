<template>
    <Column :modifier="M.width(460.dp).padding(16.dp).background(Color(0xff172331), rounded(10.dp))" :vertical-arrangement="Arrangement.spacedBy(10.dp)">
        <Text text="Canvas 三档：电平、波形与频谱" :style="{ fontSize: 17.sp, color: Color(0xffedf4fa) }"/>

        <Row :horizontal-arrangement="Arrangement.spacedBy(6.dp)">
            <GalleryButton a-for="item in tiers" :key="item.key" :text="item.title" :active="tier === item.key" :on-click="() => tier = item.key"/>
        </Row>

        <Text :text="tiers.find(item => item.key === tier)?.hint ?? ''" :style="{ fontSize: 12.sp, color: Color(0xff91a6b8) }"/>

        // 一次只挂载一档，只有当前档订阅数据；F9 叠加层的帧耗时可直接对照
        <TierA a-if="tier === 'A'"/>
        <TierB a-else-if="tier === 'B'"/>
        <TierC a-else/>
    </Column>
</template>

<script>
import { ref } from '@arrange/framework'
import { Arrangement, Color, M, rounded } from '@arrange/framework/ui'
import GalleryButton from './GalleryButton.sfa'
import TierA from './TierA.sfa'
import TierB from './TierB.sfa'
import TierC from './TierC.sfa'

const tiers = [
    { key: 'A', title: 'A 档', hint: 'JS 状态 + JS 绘制：响应式快照交付，适合低频变化' },
    { key: 'B', title: 'B 档', hint: '原生数据源 + JS 绘制：固定 Float32Array 原地更新，不经响应式' },
    { key: 'C', title: 'C 档', hint: '原生数据源 + 原生 painter：JS 只传名称与数据源' },
]
const tier = ref('A')
</script>
