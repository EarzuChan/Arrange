<template>
    <Column :modifier="M.fillMaxWidth()" :vertical-arrangement="Arrangement.spacedBy(28.dp)">
        <Section title="毛玻璃与极光" footer="渐变底叠一张平滑放大的低分辨率像素缓冲；玻璃卡取已画的极光做背景模糊，再平铺颗粒；右侧圆环只有自己逐帧重绘">
            <Box :modifier="M.fillMaxWidth().height(190.dp).background(linearGradient([Color(0xff10263a), Color(0xff2b1f47)]), rounded(12.dp)).clip(rounded(12.dp)).paint(aurora, { contentScale: 'FillBounds' }).padding(20.dp)">
                <Row vertical-alignment="CenterVertically" :modifier="M.fillMaxSize()" :horizontal-arrangement="Arrangement.spacedBy(20.dp)">
                    <Column :modifier="M.weight(1).fillMaxHeight().backdropBlur(14.dp, rounded(14.dp)).background(Color(0x30ffffff), rounded(14.dp)).border(1.dp, Color(0x50ffffff), rounded(14.dp)).paint(grain, { tile: true, alpha: 0.5 }).padding(14.dp)" :vertical-arrangement="Arrangement.spacedBy(6.dp)">
                        <Text text="毛玻璃" :style="{ fontSize: 20.sp, color: Color(0xfff2f6fa) }"/>
                        <Text text="背景模糊取已画的极光，颗粒以平铺像素缓冲叠加" :style="{ fontSize: 12.sp, color: Color(0xd0e6eef5) }"/>
                        <Spacer :modifier="M.weight(1)"/>
                        <Box :modifier="M.fillMaxWidth().height(6.dp).background(horizontalGradient([Color(0xff19c6a0), Color(0xff2f7cf6), Color(0xffb44cf2)]), rounded(3.dp))"/>
                    </Column>

                    // 旋转的扫描渐变圆环：只有这一块随动画逐帧局部重绘
                    <Canvas :modifier="M.size(140.dp, 140.dp)" :on-draw="drawRing"/>
                </Row>
            </Box>
        </Section>

        <Section title="Filmstrip 旋钮" footer="64 帧竖排图片按值取帧；拖动只重绘旋钮本身，Shift 精调，双击复位">
            <Row vertical-alignment="CenterVertically" :horizontal-arrangement="Arrangement.spacedBy(16.dp)">
                // filmstrip 旋钮：按值取帧，拖动只重绘旋钮本身
                <Box :modifier="M.size(64.dp, 64.dp).then(adjustable(knob, { valueText: `${Math.round(knobValue * 100)}%`, interactionState: knobInteraction })).pointerIcon('resizeVertical').paint(strip.at(knob.fraction))"/>
                <Column :vertical-arrangement="Arrangement.spacedBy(4.dp)">
                    <Text :text="`${Math.round(knobValue * 100)}%`" :style="{ fontSize: 28.sp, color: Color(theme.label) }"/>
                    <Text text="上下拖动调节" :style="{ fontSize: 13.sp, color: Color(theme.secondaryLabel) }"/>
                </Column>
            </Row>
        </Section>
    </Column>
</template>

<script>
import { ref, createValueDragState, createInteractionState, adjustable, editableRef } from '@arrange/framework'
import { Arrangement, Color, M, rounded, linearGradient, horizontalGradient, sweepGradient, painter, filmstrip, createPixelBuffer, type DrawScope } from '@arrange/framework/ui'
import { Canvas } from '@arrange/framework/foundation'
import { tween, linearEasing, createInfiniteTransition } from '@arrange/framework/animation'
import Section from '../../design/Section.sfa'
import { useGalleryTheme } from '../../design/theme'

const theme = useGalleryTheme()

// 极光：48x20 的低分辨率像素缓冲，平滑放大到面板
const aurora = createPixelBuffer(48, 20)
const blobs = [{ x: 0.2, y: 0.3, r: 0.35, c: [64, 214, 170] }, { x: 0.7, y: 0.6, r: 0.4, c: [120, 110, 240] }, { x: 0.5, y: 0.1, r: 0.3, c: [60, 140, 230] }]
for (let y = 0; y < aurora.height; y++) {
    for (let x = 0; x < aurora.width; x++) {
        let red = 0, green = 0, blue = 0, alpha = 0
        for (const blob of blobs) {
            const dx = x / aurora.width - blob.x, dy = (y / aurora.height - blob.y) * 0.45
            const weight = Math.max(0, 1 - Math.hypot(dx, dy) / blob.r) ** 2
            red += blob.c[0] * weight
            green += blob.c[1] * weight
            blue += blob.c[2] * weight
            alpha += weight
        }
        const a = Math.min(1, alpha) * 0.75
        const scale = alpha > 0 ? 1 / alpha : 0
        aurora.data[y * aurora.width + x] = (Math.round(a * 255) << 24 | Math.round(red * scale) << 16 | Math.round(green * scale) << 8 | Math.round(blue * scale)) >>> 0
    }
}
aurora.commit()

// 颗粒：64x64 随机灰度噪声，低不透明度平铺
const grain = createPixelBuffer(64, 64)
let seed = 7
for (let i = 0; i < grain.data.length; i++) {
    seed = (seed * 1103515245 + 12345) >>> 0
    const shade = seed >>> 24
    grain.data[i] = (0x18 << 24 | shade << 16 | shade << 8 | shade) >>> 0
}
grain.commit()

const strip = filmstrip(painter('knob-strip.png'), { frames: 64 })
const knobValue = ref(0.35)
const knob = createValueDragState({ value: editableRef(knobValue), defaultValue: 0.35 })
const knobInteraction = createInteractionState()

const spinTransition = createInfiniteTransition({ label: 'RingTransition' })
const spin = spinTransition.animatedNumber('Spin', 0, 360, { animationSpec: tween({ durationMillis: 3000, easing: linearEasing }) })

function drawRing(scope: DrawScope) {
    const { width, height } = scope.size
    const size = Math.min(width, height)
    scope.drawOval({ x: 6.px, y: 6.px, width: (size - 12).px, height: (size - 12).px, brush: sweepGradient([0xff19c6a0, 0xff2f7cf6, 0xffb44cf2, 0xffff6a8a, 0xff19c6a0], { startAngle: spin.value }), strokeWidth: 10.px })
    scope.drawText({ text: `${Math.round(spin.value)}°`, x: 0.px, y: (size / 2 - 10).px, width: size.px, color: Color(0xffedf4fa), fontSize: 16.px, textAlign: 'center' })
}
</script>
