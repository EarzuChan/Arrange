<template>
    <Column :modifier="M.fillMaxWidth()" :vertical-arrangement="Arrangement.spacedBy(28.dp)">
        <Section title="页面" footer="笔记页切走再回来，输入仍然保留；详情页的加载可以随时完成">
            <Segmented :options="pages" :value="page" :on-change="openPage" />
            <Crossfade :is="Text" :props="{ text: `当前位置：${page}`, style: { fontSize: 13.sp, color: Color(theme.secondaryLabel) } }" :targetState="page" :animationSpec="spec" />

            <KeepAlive :cacheKey="page">
                <RetainedEditor a-if="page === '笔记'" />
            </KeepAlive>

            <Row a-if="page === '详情'" vertical-alignment="CenterVertically" :modifier="M.fillMaxWidth()" :horizontal-arrangement="Arrangement.spacedBy(12.dp)">
                <Text :text="details" :style="{ fontSize: 15.sp, color: Color(theme.label) }" :modifier="M.weight(1)" />
                <GalleryButton text="完成加载" :on-click="() => run('resolve')" />
            </Row>

            <Column a-if="page === '列表'" :modifier="M.fillMaxWidth()" :vertical-arrangement="Arrangement.spacedBy(12.dp)">
                <Input :value="query" :onValueChange="value => query = value" placeholder="筛选音轨" :text-style="{ fontSize: 15.sp, color: Color(theme.label) }" :modifier="M.fillMaxWidth().height(44.dp).background(Color(theme.fill), rounded(12.dp)).padding({ horizontal: 14.dp, vertical: 12.dp })" />

                <FlowRow :horizontal-arrangement="Arrangement.spacedBy(8.dp)" :vertical-arrangement="Arrangement.spacedBy(8.dp)">
                    <GalleryButton text="重排" :on-click="() => run('reverse')" />
                    <GalleryButton text="删除选中" :on-click="() => run('remove')" />
                    <GalleryButton text="恢复" :on-click="() => run('restore')" />
                    <GalleryButton text="换色" :on-click="() => run('tone')" />
                </FlowRow>

                <Column :modifier="M.fillMaxWidth().height(260.dp).verticalScroll(scroll)" :vertical-arrangement="Arrangement.spacedBy(6.dp)">
                    <GalleryItem a-for="item in filtered" :key="item.id" :item="item" :selected="selected === item.id" :tone="tone" :on-select="select" />
                </Column>

                <Text :text="`显示 ${filtered.length} 条 · 选中 ${selected}`" :style="{ fontSize: 13.sp, color: Color(theme.secondaryLabel) }" />
            </Column>
        </Section>

        <Section title="提示" :flush="true">
            <ListRow title="显示提示">
                <Toggle :value="shown" label="显示提示" :on-change="() => run('hide')" />
            </ListRow>
            <AnimatedVisibility :visible="shown" :animation-spec="spec" :exit-to="{alpha: 0, translationX: 20.px}">
                <Text text="动画期间仍可筛选、重排、删除与切页" :style="{ fontSize: 13.sp, color: Color(theme.secondaryLabel) }" :modifier="M.padding({ start: 16.dp, end: 16.dp, bottom: 12.dp })" />
            </AnimatedVisibility>
        </Section>
    </Column>
</template>

<script>
import { Arrangement, M, Color, rounded } from '@arrange/framework/ui'
import { Text, KeepAlive, FlowRow } from '@arrange/framework/foundation'
import { AnimatedVisibility, Crossfade, tween } from '@arrange/framework/animation'
import { computed, createScrollState, onScopeDispose, ref, watch } from '@arrange/framework'
import GalleryButton from '../../design/GalleryButton.sfa'
import ListRow from '../../design/ListRow.sfa'
import Section from '../../design/Section.sfa'
import Segmented from '../../design/Segmented.sfa'
import Toggle from '../../design/Toggle.sfa'
import GalleryItem from './GalleryItem.sfa'
import RetainedEditor from './RetainedEditor.sfa'
import { useGalleryTheme } from '../../design/theme'

const theme = useGalleryTheme()
const props = defineProps({ command: { type: String, default: '' } })
const pages = ['列表', '笔记', '详情']
const page = ref('列表')
const query = ref('')
const selected = ref(1)
const tone = ref(Color(0xffd6e4ff))
const shown = ref(true)
const scroll = createScrollState()
const items = ref(Array.from({ length: 80 }, (_, index) => ({ id: index + 1, name: `音轨 ${index + 1}` })))
const filtered = computed(() => items.value.filter(item => item.name.includes(query.value)))
const spec = tween({ durationMillis: 240 })
let release: (() => void) | undefined
let request = 0
const details = ref('详情正在等待，点击完成加载')
onScopeDispose(() => {
    request++
    release = undefined
})

function makeAsyncDetails() {
    const identity = ++request
    details.value = '详情正在等待，点击完成加载'
    const ready = new Promise<void>(resolve => { release = resolve })
    ready.then(() => {
        if (identity === request) details.value = `详情已就绪 ${identity}`
    })
}

function select(id: number) { selected.value = id }

function openPage(name: string) { run(name === '笔记' ? 'editor' : name === '详情' ? 'async' : 'list') }

function run(command: string) {
    switch (command) {
        case 'select':
            selected.value = selected.value === 1 ? 2 : 1
            break

        case 'tone':
            tone.value = tone.value === Color(0xffd6e4ff) ? Color(0xffe6dcfa) : Color(0xffd6e4ff)
            break

        case 'reverse':
            items.value.reverse()
            break

        case 'remove':
            items.value = items.value.filter(item => item.id !== selected.value)
            break

        case 'restore':
            items.value = Array.from({ length: 80 }, (_, index) => ({ id: index + 1, name: `音轨 ${index + 1}` }))
            break

        case 'hide':
            shown.value = !shown.value
            break

        case 'editor':
            page.value = '笔记'
            break

        case 'list':
            page.value = '列表'
            break

        case 'async':
            page.value = '详情'
            makeAsyncDetails()
            break

        case 'resolve':
            release?.()
            break

        case 'filter':
            query.value = query.value ? '' : '音轨 1'
            break

        default: throw new Error(`画廊没有操作 ${command}`)
    }
}

watch(() => props.command, value => { if (value) run(value.split(':')[0]) }, { flush: 'sync' })
</script>
