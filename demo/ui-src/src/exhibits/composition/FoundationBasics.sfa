<template>
    <Column :modifier="M.fillMaxWidth()" :vertical-arrangement="Arrangement.spacedBy(28.dp)">
        <Section title="输入" footer="回车提交；每次输入与失焦都会回报到下面">
            <Input :value="query" :onValueChange="handleChange" :onSubmit="handleSubmit" :onChange="handleChange" :onBlur="handleBlur" placeholder="输入并提交" :text-style="{ fontSize: 13.sp, color: Color(theme.label) }" :modifier="field" />
            <Text :text="inputStatus || '还没有输入'" :style="{ fontSize: 11.sp, color: Color(theme.secondaryLabel) }" />
        </Section>

        <Section title="独立滚动" footer="卡片里的小视口自己滚动，不带动整页">
            <Column :modifier="M.fillMaxWidth().height(96.dp).background(Color(theme.fill), rounded(12.dp)).verticalScroll(localScroll).padding(12.dp)" :vertical-arrangement="Arrangement.spacedBy(8.dp)">
                <Text a-for="line in scrollLines" :key="line" :text="line" :style="{ fontSize: 11.sp, color: Color(theme.label) }" />
            </Column>
        </Section>
    </Column>
</template>

<script>
import { computed, ref, createScrollState } from '@arrange/framework'
import { Arrangement, Color, M, rounded } from '@arrange/framework/ui'
import Section from '../../design/Section.sfa'
import { useGalleryTheme } from '../../design/theme'

const theme = useGalleryTheme()
const query = ref('')
const inputStatus = ref('')
const localScroll = createScrollState()
const scrollLines = Array.from({ length: 8 }, (_, index) => `滚动内容 ${index + 1} · 独立视口`)
const field = computed(() => M.fillMaxWidth().height(44.dp).background(Color(theme.value.fill), rounded(12.dp)).padding({ horizontal: 14.dp, vertical: 12.dp }))
function handleChange(value: string) { query.value = value; inputStatus.value = `输入：${value}` }
function handleSubmit(value: string) { inputStatus.value = `提交：${value}` }
function handleBlur(value: string) { inputStatus.value = `失焦：${value}` }
</script>
