<template>
    <Column :modifier="M.fillMaxSize().background(Color(0xff0e1722)).verticalScroll(pageScroll).padding(dp(18))" :vertical-arrangement="Arrangement.spacedBy(dp(12))">
        <Row :horizontal-arrangement="Arrangement.spacedBy(dp(8))">
            <Icon :painter="playPainter" :tint="Color(0xFF00FFFF)" :modifier="M.size(dp(20), dp(20))"/>

            <Text :text="preset" :style="{ fontSize: sp(28), color: presetColor }" :modifier="M"/>

            <Image :painter="logoPainter" :modifier="M.size(dp(96), dp(40))"/>
        </Row>

        <Row :horizontal-arrangement="Arrangement.spacedBy(dp(8))" :modifier="M.fillMaxWidth().height(dp(44))">
            <Box :modifier="M.size(dp(180), dp(38)).background(Color(0xFF3A7AFE))"/>

            <Spacer :modifier="M.width(dp(8))"/>

            <Box :modifier="M.size(dp(180), dp(38)).background(Color(0xFFFFB020))"/>
        </Row>

        // 模版内支持单行双斜杠注释，带派不带派！
        <Spacer :modifier="M.height(dp(4))"/>

        <CounterPanel :clicks="clicks" :color="counterColor" :offset="counterOffset" :onTap="handleTap"/>

        <PropBoundary secret="App 传给 PropBoundary 的恩情"/> // 这是一个“不透传”的测试

        <RefRelay :state="selectedKey ? <secondRef> : <firstRef>" :name="selectedRefName" :on-toggle="toggleSelectedRef"/>

        <Input :value="preset" :onValueChange="value => preset = value" placeholder="搜索格调" :select-all-on-focus="true" :onSubmit="handleSubmit" :onChange="handleChange" :onBlur="handleBlur" :text-style="{ fontSize: sp(13), color: Color(0xFFE8EAED) }" :modifier="M.size(dp(240), dp(28)).background(Color(0xFF151922)).border(dp(1), Color(0xFF4B5563))"/>

        <Text :text="inputStatus" :style="{ fontSize: sp(12), color: Color(0xFFB8BDC7) }" :modifier="M.height(dp(16))"/>

        <Column :modifier="M.size(dp(260), dp(58)).verticalScroll(scrollState).background(Color(0xFF151922)).border(dp(1), Color(0xFF4B5563))" :vertical-arrangement="Arrangement.spacedBy(dp(4))">
            <Text text="才不想当你的滚动视口呢，哼" :style="{ fontSize: sp(12), color: Color(0xFFE8EAED) }" :modifier="M.height(dp(14))"/>

            <Text text="滚动modifier逛遍本地状态（意味不明）" :style="{ fontSize: sp(12), color: Color(0xFFB8BDC7) }" :modifier="M.height(dp(14))"/>

            <Text text="滚轮也可以触发啊一个" :style="{ fontSize: sp(12), color: Color(0xFFB8BDC7) }" :modifier="M.height(dp(14))"/>

            <Text text="这个你滚动后才能看见嘛（喜）" :style="{ fontSize: sp(12), color: Color(0xFFB8BDC7) }" :modifier="M.height(dp(14))"/>
        </Column>

        <Row :horizontal-arrangement="Arrangement.spacedBy(dp(16))">
            <ShowcaseGallery/>

            <Text text="南下"/>

            <AnimationGallery/>
        </Row>

        <Text text="Arrangeの本格界面" :style="{fontSize: sp(12), color: Color(0xff91a6b8)}"/> // 以后颜色、尺寸单位不得裸写
    </Column>
</template>

<script>
import { painter, Arrangement, Color, dp, M, sp } from "@arrange/framework/ui"
import { tween, linearEasing, animatedDpAsRef, animatedColorAsRef } from "@arrange/framework/animation"
import { Icon } from "@arrange/framework/foundation"
import { logger } from "@arrange/framework/internal"
import { onMounted, ref, createScrollState, shallowRef } from '@arrange/framework'

import CounterPanel from './view/CounterPanel.sfa'
import AnimationGallery from './view/AnimationGallery.sfa'
import ShowcaseGallery from './view/ShowcaseGallery.sfa'
import PropBoundary from './view/PropBoundary.sfa'
import RefRelay from './view/RefRelay.sfa'

const clicks = ref(0)
const firstRef = ref(11)
const secondRef = ref(29)
const selectedRefName = ref('firstRef')
const selectedKey = ref(false)
const counterOffset = animatedDpAsRef(() => clicks.value % 2 ? dp(6) : dp(0), { animationSpec: tween({ durationMillis: 240, easing: linearEasing }) })
const playPainter = painter('icons/play.svg')
const logoPainter = painter('logo.png')

const preset = ref("Arrangable与动画发廊")
const rainbow = [Color(0xFFFF3030), Color(0xFFFFFF30), Color(0xFF30FF30), Color(0xFF30FFFF), Color(0xFF3030FF), Color(0xFFFF30FF)]
const presetColorTarget = ref(Color(rainbow[0]))
let rainbowSegment = 0
const presetColor = animatedColorAsRef(presetColorTarget, {
    animationSpec: tween({ durationMillis: 700, easing: linearEasing }),
    finished() {
        rainbowSegment = (rainbowSegment + 1) % rainbow.length
        presetColorTarget.value = Color(rainbow[rainbowSegment])
    },
})
onMounted(() => {
    rainbowSegment = 1
    presetColorTarget.value = Color(rainbow[rainbowSegment])
})

const inputStatus = ref("你来和我（指输入框↑）搞一下嘛")
const scrollState = createScrollState()
const pageScroll = createScrollState()
const counterColor = animatedColorAsRef(() => clicks.value % 2 === 0 ? Color(0xFF2E7D32) : Color(0xFF3A7AFE), { animationSpec: tween({ durationMillis: 240, easing: linearEasing }) })

function toggleSelectedRef() {
    if (!selectedKey.value) {
        selectedKey.value = true
        selectedRefName.value = 'secondRef'
    } else {
        selectedKey.value = false
        selectedRefName.value = 'firstRef'
    }
}

function handleTap() {
    clicks.value += 1
    logger.info("恩情" + clicks.value)
    console.log("南下" + clicks.value)
}

function handleSubmit(value: string) {
    inputStatus.value = `提交啊一个：${value}`
}

function handleChange(value: string) {
    inputStatus.value = `改变：${value}`
}

function handleBlur(value: string) {
    inputStatus.value = `焦点搞倒：${value}`
}
</script>