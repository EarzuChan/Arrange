<template>
    <Box :modifier="M.fillMaxSize().background(Color(theme.background))">
        <GalleryHome a-if="!page" :scroll="homeScroll" :show-interop="interopEnabled" :on-open="openTopic" :on-about="() => aboutOpen = true" />

        <SubPage a-else :title="current.title" :subtitle="current.description" :icon="current.icon" :on-back="goHome">
            <CompositionPage a-if="current.key === 'composition'" />
            <DrawingExhibit a-else-if="current.key === 'drawing'" />
            <LayoutExhibit a-else-if="current.key === 'layout'" />
            <FocusExhibit a-else-if="current.key === 'focus'" />
            <LazyExhibit a-else-if="current.key === 'lazy'" />
            <ShowcaseGallery a-else-if="current.key === 'lab'" />
            <AnimationGallery a-else-if="current.key === 'animation'" />
            <M5Gallery a-else-if="current.key === 'visual'" />
            <TierGallery a-else-if="current.key === 'tiers'" />
            <InteropPanel a-else-if="current.key === 'audio'" />
            <DebugExhibit a-else-if="current.key === 'debug'" />
        </SubPage>

        // 遮罩淡入淡出，卡片在其中由略大缩回原尺寸；退场期间整层不再接收点击
        <AnimatedVisibility :visible="aboutOpen" :animation-spec="dialogSpec">
            <Box content-alignment="Center" :modifier="M.fillMaxSize().background(Color(0x66000000)).clickable({ onClick: () => aboutOpen = false, focusable: false })">
                <AnimatedVisibility :visible="aboutOpen" :appear="true" :animation-spec="dialogSpec" :enter-from="{ scaleX: 1.12, scaleY: 1.12 }" :exit-to="{ scaleX: 0.94, scaleY: 0.94 }">
                    // 卡片自身吞掉点击，只有点遮罩或「好」才关闭；裁到圆角让底部按钮的底色不越界
                    <Column :modifier="M.width(300.dp).background(Color(theme.card), rounded(20.dp)).clip(rounded(20.dp)).clickable({ onClick: () => {}, focusable: false })">
                        <Column horizontal-alignment="CenterHorizontally" :modifier="M.fillMaxWidth().padding({ start: 24.dp, end: 24.dp, top: 28.dp, bottom: 22.dp })">
                            <Image :painter="logo" :modifier="M.size(64.dp, 64.dp)" />

                            <Spacer :modifier="M.height(16.dp)" />

                            <Text text="Arrange Gallery" :style="{ fontSize: typeScale.headline.sp, color: Color(theme.label) }" />

                            <Spacer :modifier="M.height(6.dp)" />

                            <Text text="Arrange 声明式 UI 框架的交互式展示应用" text-align="center" :style="{ fontSize: typeScale.footnote.sp, color: Color(theme.secondaryLabel) }" />

                            <Spacer :modifier="M.height(4.dp)" />

                            <Text :text="`版本 ${buildInfo.version} · Framework ${buildInfo.framework}`" :style="{ fontSize: typeScale.caption.sp, color: Color(theme.secondaryLabel) }" />

                            <Spacer :modifier="M.height(4.dp)" />

                            <Text text="Earzu Chan 携众 AI 妻，为您呈现" :style="{ fontSize: typeScale.caption.sp, color: Color(theme.secondaryLabel) }" />
                        </Column>

                        <AlertAction text="好" :on-click="() => aboutOpen = false" />
                    </Column>
                </AnimatedVisibility>
            </Box>
        </AnimatedVisibility>
    </Box>
</template>

<script>
import { provide, ref, computed, createScrollState } from '@arrange/framework'
import { Color, M, painter, rounded } from '@arrange/framework/ui'
import { AnimatedVisibility, tween } from '@arrange/framework/animation'
import { hasInterop } from '@arrange/framework/interop'
import GalleryHome from './exhibits/home/GalleryHome.sfa'
import SubPage from './design/SubPage.sfa'
import AlertAction from './design/AlertAction.sfa'
import CompositionPage from './exhibits/composition/CompositionPage.sfa'
import DrawingExhibit from './exhibits/drawing/DrawingExhibit.sfa'
import LayoutExhibit from './exhibits/layout/LayoutExhibit.sfa'
import FocusExhibit from './exhibits/focus/FocusExhibit.sfa'
import LazyExhibit from './exhibits/lazy/LazyExhibit.sfa'
import ShowcaseGallery from './exhibits/showcase/ShowcaseGallery.sfa'
import AnimationGallery from './exhibits/animation/AnimationGallery.sfa'
import M5Gallery from './exhibits/graphics/M5Gallery.sfa'
import TierGallery from './exhibits/graphics/TierGallery.sfa'
import InteropPanel from './exhibits/audio/InteropPanel.sfa'
import DebugExhibit from './exhibits/debug/DebugExhibit.sfa'
import { LocalGalleryTheme, lightGalleryTheme, typeScale } from './design/theme'
import { topics, type TopicKey } from './exhibits/topics'
import { buildInfo } from './buildInfo.ts'

const theme = ref(lightGalleryTheme)
provide(LocalGalleryTheme, theme)
const interopEnabled = hasInterop()
const page = ref<TopicKey | null>(null)
// 首页时 current 不渲染，回落值只为类型收窄
const current = computed(() => topics.find(topic => topic.key === page.value) ?? topics[0])
const aboutOpen = ref(false)
const dialogSpec = tween({ durationMillis: 220 })
// 主页滚动位置由这里持有，从主题页返回时回到原处
const homeScroll = createScrollState()
const logo = painter('arrange-logo.png')
function openTopic(key: TopicKey) { page.value = key }
function goHome() { page.value = null }
</script>
