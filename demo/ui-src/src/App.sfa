<template>
    <Column :modifier="M.fillMaxSize().background(Color(0xff0e1722)).verticalScroll(pageScroll).padding(18.dp)" :vertical-arrangement="Arrangement.spacedBy(12.dp)">
        <Row :horizontal-arrangement="Arrangement.spacedBy(8.dp)">
            <Icon :painter="playPainter" :tint="Color(0xFF00FFFF)" :modifier="M.size(20.dp, 20.dp)"/>

            <Text :text="preset" :style="{ fontSize: 28.sp, color: Color.hsl(hue, 1, 0.5) }" :modifier="M"/>

            <Image :painter="logoPainter" :modifier="M.size(96.dp, 40.dp)"/>
        </Row>

        <Row :horizontal-arrangement="Arrangement.spacedBy(8.dp)" :modifier="M.fillMaxWidth().height(44.dp)">
            <Box :modifier="M.size(180.dp, 38.dp).background(Color(0xFF3A7AFE))"/>

            <Spacer :modifier="M.width(8.dp)"/>

            <Box :modifier="M.size(180.dp, 38.dp).background(Color(0xFFFFB020))"/>
        </Row>

        // 模版内支持单行双斜杠注释，带派不带派！
        <Spacer :modifier="M.height(4.dp)"/>

        <CounterPanel :clicks="clicks" :color="counterColor" :offset="counterOffset" :onTap="handleTap"/>

        <PropBoundary secret="App 传给 PropBoundary 的恩情"/> // 这是一个“不透传”的测试

        <RefRelay :state="selectedKey ? <secondRef> : <firstRef>" :name="selectedRefName" :on-toggle="toggleSelectedRef"/>

        <Input :value="preset" :onValueChange="value => preset = value" placeholder="搜索格调" :select-all-on-focus="true" :onSubmit="handleSubmit" :onChange="handleChange" :onBlur="handleBlur" :text-style="{ fontSize: 13.sp, color: Color(0xFFE8EAED) }" :modifier="M.size(240.dp, 28.dp).background(Color(0xFF151922)).border(1.dp, Color(0xFF4B5563))"/>

        <Text :text="inputStatus" :style="{ fontSize: 12.sp, color: Color(0xFFB8BDC7) }" :modifier="M.height(16.dp)"/>

        <Column :modifier="M.size(260.dp, 58.dp).verticalScroll(scrollState).background(Color(0xFF151922)).border(1.dp, Color(0xFF4B5563))" :vertical-arrangement="Arrangement.spacedBy(4.dp)">
            <Text text="才不想当你的滚动视口呢，哼" :style="{ fontSize: 12.sp, color: Color(0xFFE8EAED) }" :modifier="M.height(14.dp)"/>

            <Text text="滚动modifier撅遍本地状态（意味不明）" :style="{ fontSize: 12.sp, color: Color(0xFFB8BDC7) }" :modifier="M.height(14.dp)"/>

            <Text text="滚轮也可以触发啊一个" :style="{ fontSize: 12.sp, color: Color(0xFFB8BDC7) }" :modifier="M.height(14.dp)"/>

            <Text text="这个你滚动后才能看见嘛（喜）" :style="{ fontSize: 12.sp, color: Color(0xFFB8BDC7) }" :modifier="M.height(14.dp)"/>
        </Column>

        <Row :horizontal-arrangement="Arrangement.spacedBy(16.dp)">
            <ShowcaseGallery/>

            <Text text="润" :style="{ color: Color(0xFFAAAA00) }"/>

            <AnimationGallery/>
        </Row>

        <Text text="Arrangeの本格界面" :style="{fontSize: 12.sp, color: Color(0xff91a6b8)}"/>
    </Column>
</template>

<script>
import { painter, Arrangement, Color, M } from "@arrange/framework/ui"
import { tween, linearEasing, animatedDpAsRef, animatedColorAsRef, createInfiniteTransition } from "@arrange/framework/animation"
import { Icon } from "@arrange/framework/foundation"
import { Log } from "@arrange/framework"
import { onMounted, ref, createScrollState, shallowRef } from '@arrange/framework'
import CounterPanel from './view/CounterPanel.sfa'
import AnimationGallery from './view/AnimationGallery.sfa'
import ShowcaseGallery from './view/ShowcaseGallery.sfa'
import PropBoundary from './view/PropBoundary.sfa'
import RefRelay from './view/RefRelay.sfa'

const TAG = "App"

const clicks = ref(0)
const firstRef = ref(11)
const secondRef = ref(29)
const selectedRefName = ref('firstRef')
const selectedKey = ref(false)
const counterOffset = animatedDpAsRef(() => clicks.value % 2 ? 6.dp : 0.dp, { animationSpec: tween({ durationMillis: 240, easing: linearEasing }) })
const playPainter = painter('icons/play.svg')
const logoPainter = painter('logo.png')

const preset = ref("Arrangable与动画发廊")
const hueTransition = createInfiniteTransition({ label: 'HueTransition' })
const hue = hueTransition.animatedNumber('Hue', 0, 360, {
    animationSpec: tween({ durationMillis: 4000, easing: linearEasing }) // 没完全复刻api，之后再检查一下
})

const inputStatus = ref("你来和我（指输入框↑）搞一下嘛")
const scrollState = createScrollState()
const pageScroll = createScrollState()
const counterColor = animatedColorAsRef(() => clicks.value % 2 === 0 ? Color(0xFF2E7D32) : Color(0xFF3A7AFE), { animationSpec: tween({ durationMillis: 240, easing: linearEasing }) })

function toggleSelectedRef() {
    if (!selectedKey.value) {
        selectedKey.value = true
        selectedRefName.value = 'secondRef'
    } else {
        selectedKey.value = false
        selectedRefName.value = 'firstRef'
    }
}

function handleTap() {
    clicks.value += 1
    Log.i(TAG, "点击次数", clicks.value)
    Log.i(TAG, "南下", clicks.value)
}

function handleSubmit(value: string) {
    inputStatus.value = `提交啊一个：${value}`
}

function handleChange(value: string) {
    inputStatus.value = `改变：${value}`
}

function handleBlur(value: string) {
    inputStatus.value = `焦点搞倒：${value}`
}
</script>
