{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowImportingTsExtensions": true,
        "allowArbitraryExtensions": true,
        "noEmit": true,
        "skipLibCheck": true,
        "strict": true,
        "lib": [
            "ES2022",
            "DOM"
        ],
        "types": [
            "vite/client",
            "node"
        ]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.sfa"
    ]
}
