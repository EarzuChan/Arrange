{
  "name": "@arrange/cli",
  "description": "The official CLI of Arrange",
  "version": "1.0.0",
  "compatibility": 1,
  "private": false,
  "type": "module",
  "bin": {
    "arrange": "./dist/Entry.js"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.0",
    "commander": "^15.0.0",
    "pngjs": "7.0.0",
    "vite": "8.0.16",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "@types/pngjs": "^6.0.5",
    "tsx": "4.22.3",
    "typescript": "^5.9.0"
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  }
}
