{
  "name": "@arrange/cli",
  "description": "Arrange 官方工程管理 CLI",
  "version": "1.4.5",
  "compatibility": 4,
  "private": false,
  "type": "module",
  "bin": {
    "arrange": "./dist/Entry.js"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@xterm/headless": "5.5.0",
    "commander": "^15.0.0",
    "fast-string-width": "3.0.2",
    "koffi": "2.14.1",
    "pngjs": "7.0.0",
    "vite": "8.3.5",
    "yaml": "^2.9.0",
    "yazl": "3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "@types/pngjs": "^6.0.5",
    "@types/yazl": "2.4.6",
    "tsx": "4.22.3",
    "typescript": "^5.9.0"
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  }
}
