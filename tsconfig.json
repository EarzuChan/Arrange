{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["node", "./types/arrange-vue-globals.d.ts"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "vue": ["packages/arrange-vue-runtime-core/src/index.ts"],
      "vue/compiler-sfc": ["packages/arrange-vue-compiler-sfc/src/index.ts"],
      "@vue/shared": ["packages/arrange-vue-shared/src/index.ts"],
      "@vue/reactivity": ["packages/arrange-vue-reactivity/src/index.ts"],
      "@vue/runtime-core": ["packages/arrange-vue-runtime-core/src/index.ts"],
      "@vue/compiler-core": ["packages/arrange-vue-compiler-core/src/index.ts"],
      "@vue/compiler-dom": ["packages/arrange-vue-compiler-arrange/src/index.ts"],
      "@arrange/vue-shared": ["packages/arrange-vue-shared/src/index.ts"],
      "@arrange/vue-reactivity": ["packages/arrange-vue-reactivity/src/index.ts"],
      "@arrange/vue-runtime-core": ["packages/arrange-vue-runtime-core/src/index.ts"],
      "@arrange/vue-compiler-core": ["packages/arrange-vue-compiler-core/src/index.ts"],
      "@arrange/vue-compiler-sfc": ["packages/arrange-vue-compiler-sfc/src/index.ts"],
      "@arrange/vue-compiler-arrange": ["packages/arrange-vue-compiler-arrange/src/index.ts"],
      "@arrange/runtime": ["packages/runtime/src/index.ts"],
      "@arrange/vite-plugin": ["packages/vite-plugin/src/index.ts"],
      "@arrange/framework": ["packages/framework/src/index.ts"],
      "@arrange/framework/vite": ["packages/framework/src/vite.ts"],
      "@arrange/framework/*": ["packages/framework/src/*"]
    }
  },
  "include": [
    "packages/framework/src/**/*.ts",
    "packages/runtime/src/**/*.ts",
    "packages/vite-plugin/src/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "demo/plugin-src/**",
    "build/**",
    "artifacts/**"
  ]
}
