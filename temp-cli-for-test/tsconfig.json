{
    "compilerOptions": {
        "target": "ES2023",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "erasableSyntaxOnly": true,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": ["*.ts", "tui/**/*.ts", "tui/**/*.js"],
    "exclude": ["node_modules"]
}
