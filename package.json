{
  "name": "arrange",
  "private": true,
  "type": "module",
  "workspaces": [
    "cli",
    "packages/*"
  ],
  "scripts": {
    "format": "node --import tsx scripts/format-code.ts --write",
    "format:check": "node --import tsx scripts/format-code.ts",
    "format:native": "node --import tsx scripts/format-native.ts --write",
    "format:native:check": "node --import tsx scripts/format-native.ts",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:runtime": "node --import tsx --test tests/runtime/*.test.ts",
    "test:native": "node --import tsx scripts/test-native.ts",
    "test:quickjs": "node --import tsx scripts/test-quickjs-app.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:sfa": "node --import tsx scripts/typecheck-sfa.ts",
    "build:packages": "node --import tsx scripts/build-internal-packages.ts",
    "sync:version": "node --import tsx scripts/sync-version.ts",
    "verify:version": "node --import tsx scripts/verify-version.ts",
    "sync:modifier-schema": "node --import tsx scripts/modifier-schema.ts",
    "verify:modifier-schema": "node --import tsx scripts/modifier-schema.ts --check",
    "verify:native-fetchcontent": "node --import tsx scripts/verify-native-fetchcontent.ts",
    "pack:package": "node --import tsx scripts/pack-npm-package.ts",
    "publish:local": "node --import tsx scripts/publish-local.ts",
    "verify:npm-package": "node --import tsx scripts/verify-npm-package.ts",
    "verify:npm-registry-package": "node --import tsx scripts/verify-npm-registry-package.ts",
    "verify:platform": "node --import tsx scripts/verify-platform.ts"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "source-map-js": "catalog:",
    "tsx": "4.22.3",
    "typescript": "^5.9.0",
    "vite": "8.3.5"
  },
  "version": "0.6.0",
  "engines": {
    "node": ">=24"
  }
}
